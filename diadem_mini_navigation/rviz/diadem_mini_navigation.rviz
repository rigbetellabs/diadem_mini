Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
      Splitter Ratio: 0.38333332538604736
    Tree Height: 718
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Plane Cell Count: 1000
      Value: true
    - Class: rviz/RobotModel
      Links:
        FL_wheel_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        FR_wheel_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        Link Tree Style: Links in Alphabetic Order
        RL_wheel_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        RR_wheel_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        imu_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        velodyne:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        velodyne_base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: RobotModel
      Value: true
    - Class: rviz/Axes
      Name: Axes
      Radius: 0.004999999888241291
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: foot
      Name: MarkerArray
      Value: false
    - Class: rviz/Pose
      Name: Pose
      Topic: /pose_debug
      Value: true
    - Autocompute Value Bounds:
        Max Value: 5.61601448059082
        Min Value: -2.9595704078674316
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: '1e+07'
      Name: PointCloud2
      Position Transformer: XYZ
      Size (m): 0.029999999329447746
      Topic: /scan_matched_points2
      Value: true
    - Class: rviz/LaserScan
      Color: 239; 41; 41
      Color Transformer: FlatColor
      Name: LaserScan
      Position Transformer: XYZ
      Size (m): 0.05000000074505806
      Topic: /scan
      Unreliable: true
      Use rainbow: false
      Value: true
    - Class: rviz/Map
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz/Path
      Color: 92; 53; 102
      Name: Path
      Topic: /move_base/NavfnROS/plan
      Value: true
    - Class: rviz/Path
      Name: Path
      Topic: /move_base/DWAPlannerROS/local_plan
      Value: true
    - Class: rviz/Map
      Name: Map
      Topic: /move_base/local_costmap/costmap
      Value: true
    - Alpha: 0.800000011920929
      Class: rviz/Map
      Color Scheme: costmap
      Name: Map
      Topic: /move_base/global_costmap/costmap
      Value: true
    - Class: rviz/MarkerArray
      Marker Topic: /trajectory_node_list
      Name: MarkerArray
      Value: true
    - Class: rviz/TF
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frames:
        FL_wheel_1:
          Value: true
        FR_wheel_1:
          Value: true
        RL_wheel_1:
          Value: true
        RR_wheel_1:
          Value: true
        base_link:
          Value: true
        imu_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        velodyne:
          Value: true
        velodyne_base_link:
          Value: true
      Name: TF
      Tree:
        map:
          odom:
            base_link:
              FL_wheel_1: {}
              FR_wheel_1: {}
              RL_wheel_1: {}
              RR_wheel_1: {}
              imu_link: {}
              velodyne_base_link:
                velodyne: {}
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
