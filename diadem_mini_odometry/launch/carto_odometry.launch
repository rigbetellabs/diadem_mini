<?xml version="1.0"?>


<launch>

    <!-- Start Google Cartographer node with custom configuration file-->
    <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node"
        args="
          -configuration_directory
              $(find diadem_mini_odometry)/config
          -configuration_basename lidar.lua"
        output="screen">
    </node>

    <node name="odom_publisher" pkg="diadem_mini_firmware" type="odom_pub.py" output="screen" />
    <!--<node name="MapstoUnity" pkg="diadem_mini_firmware" type="map_unity.py" output="screen" /> -->

</launch>
