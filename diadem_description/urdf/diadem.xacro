<?xml version="1.0" ?>
<robot name="diadem" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ============================================================
     DIADEM V2 - Compact Platform
     Wheel track width  : 520 mm  → separation = 0.52 m
     Wheel base         : 500 mm  → ±0.25 m in X
     Wheel radius       : 12 in   → 0.3048 m
     Wheel width        : ~100 mm → 0.10 m
     Base mass          : 90 kg
     Body dimensions    : 810 mm (L) × 570 mm (W) × ~300 mm (H)
     LiDAR (RP-LiDAR A3 equivalent): r=0.05m, h=0.06m, @0.75m above base
     ============================================================ -->

<xacro:include filename="$(find diadem_description)/urdf/materials.xacro" />
<xacro:include filename="$(find diadem_description)/urdf/diadem.trans" />
<xacro:include filename="$(find diadem_description)/urdf/diadem.gazebo" />


<link name="base_link">
  <inertial>
    <!-- CoM slightly above geometric center; Z≈0.15 (half of 0.30m body height) -->
    <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
    <mass value="90.0"/>
    <!-- Box inertia: L=0.81, W=0.57, H=0.30  (all meters)
         Ixx = m/12*(W²+H²) = 90/12*(0.3249+0.09)  = 3.112
         Iyy = m/12*(L²+H²) = 90/12*(0.6561+0.09)  = 5.595
         Izz = m/12*(L²+W²) = 90/12*(0.6561+0.3249) = 7.357  -->
    <inertia ixx="3.112" iyy="5.595" izz="7.357" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <!-- Scaled body to perfectly align visual axle shafts with V2 wheel joints:
         sx = 0.25/0.28 = 0.000892857 -> aligns X axles at ±0.25m
         sy = 0.00080 -> 400mm visual breadth (clears wheel inner faces at ±0.21m)
         sz = 0.3048/0.18 = 0.00169333 -> aligns Z axles at height 0.3048m -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://diadem_description/meshes/base_link.dae" scale="0.000892857 0.00080 0.00133333"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="base_link_collision">
    <!-- Inset collision: X=0.42m, Y=0.38m (clears wheels completely), Z=0.25m (floats above ground) -->
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <geometry>
      <box size="0.42 0.38 0.30"/>
    </geometry>
  </collision>
</link>

<!-- =================== WHEELS =================== -->
<!-- Wheel radius = 12 in = 0.3048 m; width = 0.10 m
     Cylinder inertia (solid):
       Ixx = Izz = m/12*(3r²+h²) = 11.4/12*(3*0.09290+0.01) = 0.273
       Iyy        = m*r²/2        = 11.4*0.09290/2            = 0.530  -->

<link name="RR_wheel_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="11.4"/>
    <inertia ixx="0.174" iyy="0.328" izz="0.174" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <!-- Exact mathematical offset to center the scaled wheel at joint origin -->
    <origin xyz="0.37333 0.40 -0.24" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://diadem_description/meshes/RR_wheel_1.dae" scale="0.00133333 0.00133333 0.00133333"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="RR_wheel_1_collision">
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.24" length="0.10"/>
    </geometry>
  </collision>
</link>

<link name="FL_wheel_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="11.4"/>
    <inertia ixx="0.174" iyy="0.328" izz="0.174" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.37333 -0.40 -0.24" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://diadem_description/meshes/FL_wheel_1.dae" scale="0.00133333 0.00133333 0.00133333"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="FL_wheel_1_collision">
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.24" length="0.10"/>
    </geometry>
  </collision>
</link>

<link name="RL_wheel_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="11.4"/>
    <inertia ixx="0.174" iyy="0.328" izz="0.174" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.37333 -0.40 -0.24" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://diadem_description/meshes/RL_wheel_1.dae" scale="0.00133333 0.00133333 0.00133333"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="RL_wheel_1_collision">
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.24" length="0.10"/>
    </geometry>
  </collision>
</link>

<link name="FR_wheel_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="11.4"/>
    <inertia ixx="0.174" iyy="0.328" izz="0.174" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.37333 0.40 -0.24" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://diadem_description/meshes/FR_wheel_1.dae" scale="0.00133333 0.00133333 0.00133333"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="FR_wheel_1_collision">
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.24" length="0.10"/>
    </geometry>
  </collision>
</link>

<!-- =================== LiDAR =================== -->
<!-- Modelled as RP-LiDAR A3 equivalent: r=0.05m, h=0.06m, mass=0.19kg -->
<link name="lidar">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.19"/>
    <inertia ixx="0.0002" iyy="0.0002" izz="0.0003" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.05" length="0.06"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.05" length="0.06"/>
    </geometry>
  </collision>
</link>

<!-- =================== FIXED LINKS =================== -->
<link name="imu_link"/>
<link name="camera_link"/>

<!-- =================== JOINTS =================== -->

<!-- IMU at ~top of body box: body H=0.30 m -->
<joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.30"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
</joint>

<!-- Wheel joints
     X = ±wheelbase/2 = ±0.25 m
     Y = ±track/2     = ±0.26 m  (track=0.52m, half=0.26m)
     Z = wheel radius  = 0.3048 m (wheel hub height above base_link origin)
-->

<!-- RR: Rear-Right  → X=-0.25, Y=-0.26 -->
<joint name="RR_wheel_joint" type="continuous">
  <origin xyz="-0.25 -0.26 0.24" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="RR_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- FL: Front-Left  → X=+0.25, Y=+0.26 -->
<joint name="FL_wheel_joint" type="continuous">
  <origin xyz="0.25 0.26 0.24" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="FL_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- RL: Rear-Left   → X=-0.25, Y=+0.26 -->
<joint name="RL_wheel_joint" type="continuous">
  <origin xyz="-0.25 0.26 0.24" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="RL_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- FR: Front-Right → X=+0.25, Y=-0.26 -->
<joint name="FR_wheel_joint" type="continuous">
  <origin xyz="0.25 -0.26 0.24" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="FR_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- LiDAR: mounted on top of body, centred, at body_H + half_lidar_H = 0.30+0.03 = 0.33m
     Add 0.42m additional mast to clear the body and give good scan plane -->
<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.75" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar"/>
</joint>

<!-- Camera: slightly ahead of centre, tilted down 15° -->
<joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.30 0.0 0.55" rpy="0.0 0.26 0"/>
</joint>


</robot>
